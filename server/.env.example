# API サーバー設定（.env にコピーして使う。.env は git 管理外・パーミッション 600 推奨）

PORT=3001
# 待ち受けアドレス。cloudflared は同じホストの localhost に向けて繋ぐので 127.0.0.1 で十分。
# 0.0.0.0 にすると同一 LAN からトンネルをバイパスして直接叩けるので非推奨。
HOST=127.0.0.1
DB_PATH=./data/mbti.db

# 認証トークン（Netlify Function の API_TOKEN と同値）。本番（NODE_ENV=production）では必須。
API_TOKEN=change-me-to-random-string

# 任意: Netlify Function だけが知る共有秘密。設定すると、書き込み（POST/DELETE）
# は X-Proxy-Secret ヘッダを持つ Function 経由のリクエストだけ許可される。
# Netlify ダッシュボードの同名変数 PROXY_SECRET にも同じ値を設定する。
# PROXY_SECRET=

# 任意: ブラウザがオリジン跨ぎで直接 API を叩く場合だけ許可する（カンマ区切り）。
# Netlify Function プロキシ経由（同一オリジン）の運用では不要。
# ALLOWED_ORIGIN=https://<your-netlify-site>.netlify.app,http://localhost:5173

# 任意: レート制限（IP 単位・毎分）。書き込みを厳しめにしている。
RATE_LIMIT_READ=120
RATE_LIMIT_WRITE=20
